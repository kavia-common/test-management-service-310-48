# Eclipse Ditto configuration
DITTO_BASE_URL=http://localhost:8080/api/2
# Option 1: Provide prebuilt Authorization header
# DITTO_AUTH=Basic BASE64_ENCODED_TOKEN
# Option 2: Provide username/password (will be converted to Basic)
# DITTO_USERNAME=
# DITTO_PASSWORD=

# Graph API (optional; if not provided, in-memory fallback is used)
# GRAPH_API_BASE_URL=http://localhost:7474/api
# GRAPH_AUTH=YOUR_BEARER_TOKEN

# HTTP client behavior
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRIES=2

# Fallback toggles
ENABLE_INMEMORY_GRAPH=true
ENABLE_INMEMORY_DITTO=false

# Database Configuration
# REQUIRED: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/robot_test_db

# MinIO Storage Configuration
# REQUIRED: MinIO server endpoint (without http://)
MINIO_ENDPOINT=localhost:9000

# REQUIRED: MinIO access credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# OPTIONAL: MinIO bucket name (default: robot-tests)
MINIO_BUCKET_NAME=robot-tests

# OPTIONAL: Use HTTPS for MinIO (default: false)
MINIO_SECURE=false

# Robot Framework Execution Settings
# OPTIONAL: Default timeout for test execution in seconds (default: 300)
ROBOT_EXECUTION_TIMEOUT=300

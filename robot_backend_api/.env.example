# Application Settings
APP_NAME=Robot Framework Test Management API
APP_VERSION=1.0.0

# Database Configuration (REQUIRED)
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/robot_test_db

# MinIO Storage Configuration (REQUIRED)
# MinIO server endpoint (without http:// or https://)
MINIO_ENDPOINT=localhost:9000

# MinIO access credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO bucket name for storing robot files and logs
MINIO_BUCKET_NAME=robot-tests

# Whether to use HTTPS for MinIO (true/false)
MINIO_SECURE=false

# Robot Framework Execution Settings
# Default timeout for robot test execution in seconds
ROBOT_EXECUTION_TIMEOUT=300
